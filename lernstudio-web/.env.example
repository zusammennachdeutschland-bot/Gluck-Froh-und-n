# Environment Variables for Glück Lernstudio Web + Homework
# Configure these in your Vercel Project Settings -> Environment Variables

# 1. Vercel Blob Read/Write Token (Required for persistent assignment and student submission storage)
# Obtain this from your Vercel Project -> Storage -> Create Blob Store
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 2. Teacher Access Password (Required to protect the /teacher dashboard & APIs)
TEACHER_PASSWORD="YourStrongTeacherPasswordHere123"

# 3. Session Signing Secret (Random 32+ character key for secure HttpOnly cookie sessions)
SESSION_SECRET="e9a8f27c3d1b4a6e5f8a0c2d4e6b8a1c3d5e7f9a1b3c5d7e9f1a3b5c7d9e1f3a"
