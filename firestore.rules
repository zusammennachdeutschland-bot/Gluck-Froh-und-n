rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS (Phase 3) ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- VALIDATION BLUEPRINTS (Pillar 2) ---

    function isValidLernstudioSet(data) {
      return data.keys().hasAll(['id', 'title', 'payloadJson', 'updatedAtIso'])
        && data.keys().hasOnly(['id', 'title', 'category', 'payloadJson', 'updatedAtIso', 'deleted'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 500000
        && data.updatedAtIso is string && data.updatedAtIso.size() >= 1 && data.updatedAtIso.size() <= 64
        && (!('deleted' in data) || data.deleted is bool);
    }

    function isValidHomeworkAssignment(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'createdAt', 'isActive', 'payloadJson'])
        && data.keys().hasOnly(['id', 'ownerUid', 'title', 'createdAt', 'isActive', 'payloadJson', 'ownerEmail', 'shareToken'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64
        && data.isActive is bool
        && data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 500000;
    }

    function isValidHomeworkSubmission(data) {
      return data.keys().hasAll(['id', 'assignmentId', 'ownerUid', 'studentName', 'score', 'accuracyPercent', 'completedAt', 'payloadJson'])
        && data.keys().hasOnly(['id', 'assignmentId', 'ownerUid', 'studentName', 'score', 'accuracyPercent', 'completedAt', 'payloadJson', 'ownerEmail', 'attemptSecret', 'status'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.assignmentId is string && data.assignmentId.size() >= 1 && data.assignmentId.size() <= 128
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.score is number && data.score >= 0 && data.score <= 100000
        && data.accuracyPercent is number && data.accuracyPercent >= 0 && data.accuracyPercent <= 100
        && data.completedAt is string && data.completedAt.size() >= 0 && data.completedAt.size() <= 64
        && (!('status' in data) || (data.status is string && data.status.size() >= 1 && data.status.size() <= 32))
        && (!('attemptSecret' in data) || (data.attemptSecret is string && data.attemptSecret.size() >= 1 && data.attemptSecret.size() <= 128))
        && data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 500000;
    }

    function isValidWorkspaceChunk(data) {
      return data.keys().hasAll(['id', 'categoryKey', 'chunkIndex', 'totalChunks', 'updatedAtMs', 'updatedAtIso', 'deviceId', 'payloadChunk'])
        && data.keys().hasOnly(['id', 'categoryKey', 'chunkIndex', 'totalChunks', 'updatedAtMs', 'updatedAtIso', 'deviceId', 'payloadChunk', 'ownerEmail', 'ownerUid'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.categoryKey is string && data.categoryKey.size() >= 1 && data.categoryKey.size() <= 100
        && data.chunkIndex is number && data.chunkIndex >= 0 && data.chunkIndex <= 200
        && data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 200
        && data.updatedAtMs is number && data.updatedAtMs >= 0
        && data.updatedAtIso is string && data.updatedAtIso.size() >= 1 && data.updatedAtIso.size() <= 64
        && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 100
        && data.payloadChunk is string && data.payloadChunk.size() <= 750000;
    }

    function isValidShortId(shortId) {
      return shortId is string && shortId.size() >= 6 && shortId.size() <= 10 && shortId.matches('^[A-Za-z0-9]+$');
    }

    function isValidHomeworkShortLink(data) {
      return data.keys().hasAll(['shortId', 'assignmentId', 'ownerUid', 'isActive', 'createdAt', 'payloadJson'])
        && data.keys().hasOnly(['shortId', 'assignmentId', 'ownerUid', 'shareToken', 'isActive', 'createdAt', 'updatedAt', 'payloadJson', 'deleted'])
        && data.shortId is string && data.shortId.size() >= 6 && data.shortId.size() <= 10 && data.shortId.matches('^[A-Za-z0-9]+$')
        && data.assignmentId is string && data.assignmentId.size() >= 1 && data.assignmentId.size() <= 128
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && (!('shareToken' in data) || (data.shareToken is string && data.shareToken.size() <= 128))
        && data.isActive is bool
        && data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('deleted' in data) || data.deleted is bool)
        && data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 500000;
    }

    // --- COLLECTION RULES ---

    // Connection test doc (Safe public read)
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Shared Lernstudio library: every authenticated teacher account sees and manages the same custom sets.
    // Public single-document get remains available for student share links; enumeration requires sign-in.
    match /lernstudio_sets/{setId} {
      allow get: if isValidId(setId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(setId)
        && isValidLernstudioSet(incoming())
        && incoming().id == setId;
      allow update: if isSignedIn()
        && isValidId(setId)
        && isValidLernstudioSet(incoming())
        && incoming().id == setId;
      allow delete: if isSignedIn() && isValidId(setId);
    }

    // Homework Assignments (Strictly isolated by teacher ownerUid; public get via server Express DTO API)
    match /homework_assignments/{assignmentId} {
      allow get: if isSignedIn() && isValidId(assignmentId) && existing().ownerUid == request.auth.uid;

      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(assignmentId)
        && isValidHomeworkAssignment(incoming())
        && incoming().id == assignmentId
        && incoming().ownerUid == request.auth.uid;

      allow update: if isSignedIn()
        && isValidId(assignmentId)
        && (!('deleted' in existing()) || existing().deleted != true)
        && isValidHomeworkAssignment(incoming())
        && incoming().id == assignmentId
        && (
          (existing().ownerUid == request.auth.uid && incoming().ownerUid == existing().ownerUid)
          || (
            (!('ownerUid' in existing()) || existing().ownerUid == '')
            && incoming().ownerUid == request.auth.uid
            && (!('ownerEmail' in existing()) || existing().ownerEmail == '' || (request.auth.token.email != null && existing().ownerEmail == request.auth.token.email))
          )
        );

      allow delete: if isSignedIn()
        && isValidId(assignmentId)
        && existing().ownerUid == request.auth.uid;
    }

    // Homework Short Links (/Herr-Abdul-rahman/{shortId})
    // Single-document get by exact shortId is allowed for cross-device student resolution;
    // list and all writes are strictly restricted to the authenticated owning teacher.
    match /homework_short_links/{shortId} {
      allow get: if isValidShortId(shortId);
      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;

      allow create: if isSignedIn()
        && isValidShortId(shortId)
        && !exists(/databases/$(database)/documents/homework_short_links/$(shortId))
        && isValidHomeworkShortLink(incoming())
        && incoming().shortId == shortId
        && incoming().ownerUid == request.auth.uid;

      allow update: if isSignedIn()
        && isValidShortId(shortId)
        && isValidHomeworkShortLink(incoming())
        && incoming().shortId == shortId
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().assignmentId == existing().assignmentId;

      allow delete: if isSignedIn()
        && isValidShortId(shortId)
        && existing().ownerUid == request.auth.uid;
    }

    // Student Submissions (Strictly readable/deletable only by owning teacher; students can submit to active shared assignments)
    match /homework_submissions/{submissionId} {
      allow get, list: if isSignedIn() && existing().ownerUid == request.auth.uid;

      allow create: if isValidId(submissionId)
        && isValidHomeworkSubmission(incoming())
        && incoming().id == submissionId
        && exists(/databases/$(database)/documents/homework_assignments/$(incoming().assignmentId))
        && (!('deleted' in get(/databases/$(database)/documents/homework_assignments/$(incoming().assignmentId)).data) || get(/databases/$(database)/documents/homework_assignments/$(incoming().assignmentId)).data.deleted != true)
        && get(/databases/$(database)/documents/homework_assignments/$(incoming().assignmentId)).data.isActive == true
        && (
          incoming().ownerUid == get(/databases/$(database)/documents/homework_assignments/$(incoming().assignmentId)).data.ownerUid
          || (
            (!('ownerUid' in get(/databases/$(database)/documents/homework_assignments/$(incoming().assignmentId)).data) || get(/databases/$(database)/documents/homework_assignments/$(incoming().assignmentId)).data.ownerUid == '')
            && incoming().ownerUid == ('legacy_unclaimed_' + incoming().assignmentId)
          )
        );

      allow update: if isValidId(submissionId)
        && isValidHomeworkSubmission(incoming())
        && incoming().id == submissionId
        && incoming().assignmentId == existing().assignmentId
        && (
          // Tier 1: Owning teacher updating or backfilling legacy submission
          (
            isSignedIn()
            && incoming().ownerUid == request.auth.uid
            && (
              existing().ownerUid == request.auth.uid
              || (
                (!('ownerUid' in existing()) || existing().ownerUid == '' || existing().ownerUid == ('legacy_unclaimed_' + existing().assignmentId))
                && exists(/databases/$(database)/documents/homework_assignments/$(existing().assignmentId))
                && get(/databases/$(database)/documents/homework_assignments/$(existing().assignmentId)).data.ownerUid == request.auth.uid
              )
            )
          )
          // Tier 2: Student updating their own active attempt (cannot overwrite another student, change studentName, alter a completed submission, or bypass attemptSecret)
          || (
            incoming().ownerUid == existing().ownerUid
            && incoming().studentName == existing().studentName
            && (!('attemptSecret' in existing()) || existing().attemptSecret == '' || ('attemptSecret' in incoming() && incoming().attemptSecret == existing().attemptSecret))
            && (existing().completedAt == '' || incoming().completedAt != '')
            && (!('status' in existing()) || existing().status != 'completed')
            && exists(/databases/$(database)/documents/homework_assignments/$(existing().assignmentId))
            && (!('deleted' in get(/databases/$(database)/documents/homework_assignments/$(existing().assignmentId)).data) || get(/databases/$(database)/documents/homework_assignments/$(existing().assignmentId)).data.deleted != true)
            && get(/databases/$(database)/documents/homework_assignments/$(existing().assignmentId)).data.isActive == true
            && (
              get(/databases/$(database)/documents/homework_assignments/$(existing().assignmentId)).data.ownerUid == incoming().ownerUid
              || (
                (!('ownerUid' in get(/databases/$(database)/documents/homework_assignments/$(existing().assignmentId)).data) || get(/databases/$(database)/documents/homework_assignments/$(existing().assignmentId)).data.ownerUid == '')
                && incoming().ownerUid == ('legacy_unclaimed_' + existing().assignmentId)
              )
            )
          )
        );

      allow delete: if isSignedIn()
        && isValidId(submissionId)
        && existing().ownerUid == request.auth.uid;
    }

    // Teacher Full App Cloud Sync (STRICTLY Isolated by UID - Pillar 8)
    match /user_workspaces/{userId}/categories/{docId} {
      allow get, list: if isOwner(userId) || (isSignedIn() && request.auth.token.email != null && (resource == null || resource.data.ownerEmail == request.auth.token.email));
      
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && isValidId(docId)
        && isValidWorkspaceChunk(incoming())
        && incoming().id == docId;
      
      allow delete: if isOwner(userId) || (isSignedIn() && request.auth.token.email != null && resource.data.ownerEmail == request.auth.token.email);
    }
  }
}
