rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // Private Collections (System Only - Zero Client Access)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
