# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_GRAMMAR_MODEL: Model used by Firebase AI Logic photo-to-set extraction
# (client reads VITE_GEMINI_GRAMMAR_MODEL; keep both in sync).
# Verified for Firebase AI Logic (late Nov 2026): gemini-3.5-flash-lite primary,
# gemini-3.8-flash fallback. No API key is used — auth is Firebase Auth + App Check.
GEMINI_GRAMMAR_MODEL="gemini-3.5-flash-lite"
VITE_GEMINI_GRAMMAR_MODEL="gemini-3.5-flash-lite"

# VITE_RECAPTCHA_ENTERPRISE_SITE_KEY: App Check reCAPTCHA Enterprise site key
# for project glueck-c8621 (Firebase Console -> App Check -> reCAPTCHA Enterprise).
# Required for Firebase AI Logic calls; without it extraction shows an Arabic
# "not configured" message and falls back to manual code paste. Never commit a
# real key here — set it in Vercel env vars / local .env only.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ANDROID RELEASE SIGNING (Configure via GitHub Actions Secrets or local environment)
ANDROID_KEYSTORE_PATH=""
ANDROID_KEYSTORE_BASE64=""
ANDROID_STORE_PASSWORD=""
ANDROID_KEY_ALIAS=""
ANDROID_KEY_PASSWORD=""

# GOOGLE_CLIENT_ID: Required for Google Sign-In (Web OAuth 2.0 Client ID for glueck-c8621)
VITE_GOOGLE_CLIENT_ID="874458026984-3ai954q2p8ga6h4b2b15is2gdjbi9768.apps.googleusercontent.com"

# GRAIN_PERSONAL_ACCESS_TOKEN: Optional server-side Grain Personal API token (never expose via VITE_).
GRAIN_PERSONAL_ACCESS_TOKEN=""

# SERVER VAULT ENCRYPTION KEYS (Required on Vercel for persistent encrypted Grain/Zoom credentials; never prefix with VITE_)
GRAIN_VAULT_MASTER_KEY=""
ZOOM_VAULT_MASTER_KEY=""

